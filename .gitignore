# =========================================================
# BookManagement - Git Ignore
# ASP.NET Core + .NET + Angular
# =========================================================


# =========================================================
# .NET / ASP.NET Core
# =========================================================

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

# Architecture-specific build output
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ww][Ii][Nn]32/

# .NET artifacts
artifacts/
project.lock.json
project.fragment.lock.json

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# NuGet generated files
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml

# Coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Logs
*.log
[Ll]og/
[Ll]ogs/

# Temporary files
*.tmp
*.tmp_proj
*.temp


# =========================================================
# Visual Studio
# =========================================================

.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio generated files
*.pdb
*.ilk
*.obj
*.iobj
*.pch
*.ipdb
*.pgc
*.pgd
*.rsp
*.cache

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/
*.sln.iml


# =========================================================
# VS Code
# =========================================================

# Ignore VS Code files by default
.vscode/*

# Keep project-specific settings if desired
!.vscode/settings.json

# Workspace files
*.code-workspace

# VS Code history
.history/


# =========================================================
# ASP.NET Core
# =========================================================

# Local publish output
publish/

# User-specific ASP.NET files
ScaffoldingReadMe.txt

# Local secrets / environment files
.env
.env.*
!.env.example


# =========================================================
# SQLite / Local Databases
# =========================================================

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# SQLite temporary files
*.sqlite-journal


# =========================================================
# Angular / Node.js
# =========================================================

# Dependencies
node_modules/

# Angular build output
dist/
.angular/

# Angular cache
.cache/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/

# Angular environment files containing local configuration
# Uncomment these if they contain secrets:
# src/environments/environment.ts
# src/environments/environment.development.ts


# =========================================================
# OS Generated Files
# =========================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory


# =========================================================
# Temporary / Backup Files
# =========================================================

*~
*.swp
*.swo
*.bak
*.orig
*.old

# Temporary Visual Studio / tooling files
*.userprefs
*.pidb
*.svclog


# =========================================================
# Certificates / Private Keys
# =========================================================

# Do not commit private certificates or keys
*.pfx
*.p12
*.key

# ASP.NET development certificates
*.pem


# =========================================================
# Azure / Deployment
# =========================================================

*.pubxml
*.publishproj
PublishScripts/

# Azure publish profiles can contain credentials
Properties/PublishProfiles/


# =========================================================
# Python (if used for scripts/tools later)
# =========================================================

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/


# =========================================================
# Local History / IDE caches
# =========================================================

.localhistory/
.vshistory/


# =========================================================
# Miscellaneous
# =========================================================

BenchmarkDotNet.Artifacts/
NCrunch_*
.ncrunch*
.dotCover*
OpenCover/
.axoCover/